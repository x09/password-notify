[Desktop Entry]
Type=Application
Name=Password Expiration Notifier
Comment=Domain password expiration notification for Samba AD
Icon=dialog-password
Exec=password-notify -a
Terminal=false
Categories=System;Security;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=panel
X-MATE-Autostart-enabled=true
